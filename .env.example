# Copy to .env; start.sh loads this trusted local shell file.
CAREERLENS_MODE=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=180
OLLAMA_NUM_CTX=4096
CAREERLENS_HOST=127.0.0.1
CAREERLENS_PORT=8000
